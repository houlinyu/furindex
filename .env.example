# Supabase project settings -> API
# Safe to expose to the browser (protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Where magic-link emails should send people back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import this outside a server file, never paste it into a client component.
# Not required for the current feature set — leave unset unless you add admin tooling.
# SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY — used to parse uploaded vet reports into structured records.
# Never prefix with NEXT_PUBLIC_. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...
